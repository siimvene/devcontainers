#!/usr/bin/env bash
# sandbox — run Claude Code inside the repo's devcontainer.
# Install once per machine:  cp sandbox /opt/homebrew/bin/   (macOS)
#                             install -D sandbox ~/.local/bin/sandbox   (Linux)
#
# Usage:
#   sandbox init                 # one-time machine onboarding (guided, ~5 min)
#   sandbox sync [dir]           # refresh the repo's .devcontainer from its template source
#   sandbox rebuild [dir]        # recreate the container (after sync/compose changes), then Claude
#   sandbox                      # interactive Claude in the current repo's container
#   sandbox ~/git/some-repo      # same, for another repo
#   sandbox -p "fix the tests"   # headless dispatch; any claude args pass through
#
# Mental model: watching it? `claude` (host, prompts on). Leaving it alone or
# running auto mode? `sandbox` — autonomy lives inside the container.
set -euo pipefail

AGENT_ENV="${AGENT_ENV:-$HOME/.agent/agent.env}"

# ─────────────────────────────── sandbox init ────────────────────────────────
# Guided machine onboarding: prereqs → 1Password item → tokens (captured
# straight into the vault, never onto disk) → agent.env with op:// refs →
# host-side validation of every credential. Idempotent: reruns only fix gaps.
if [ "${1:-}" = "init" ]; then
  ok()   { printf '  \033[32m✔\033[0m %s\n' "$1"; }
  bad()  { printf '  \033[31m✘\033[0m %s\n' "$1"; }
  note() { printf '  \033[33m→\033[0m %s\n' "$1"; }
  fail=0

  case "$(uname -s)" in
    Darwin) DOCKER_HINT="install Docker Desktop and start it"
            OP_HINT="brew install --cask 1password-cli" ;;
    *)      DOCKER_HINT="install docker and start it (Linux: add yourself to the docker group; Windows: use WSL2 + Docker Desktop WSL backend)"
            OP_HINT="https://developer.1password.com/docs/cli/get-started/" ;;
  esac
  echo "── prerequisites ──"
  command -v docker >/dev/null && docker info >/dev/null 2>&1 \
    && ok "docker running" || { bad "docker not running — $DOCKER_HINT"; fail=1; }
  command -v devcontainer >/dev/null \
    && ok "devcontainer CLI $(devcontainer --version)" \
    || { bad "devcontainer CLI missing — run: npm install -g --ignore-scripts @devcontainers/cli"; fail=1; }
  command -v claude >/dev/null && ok "claude CLI" || { bad "claude CLI missing — install Claude Code first"; fail=1; }
  command -v op >/dev/null && ok "1Password CLI" || note "1Password CLI not found (optional — plaintext fallback available)"
  [ "$fail" -eq 1 ] && { echo "fix the above, rerun: sandbox init"; exit 1; }

  OP_MODE=0
  if command -v op >/dev/null; then
    note "checking 1Password CLI connection — Ctrl+C skips 1Password (Windows: op can hang waiting on a desktop-app prompt)"
    # trap keeps Ctrl+C from killing init: it kills the hanging `op` child,
    # the check comes back non-zero, and we continue into the fallback path.
    trap ':' INT
    if op whoami >/dev/null 2>&1 || op vault list >/dev/null 2>&1; then OP_MODE=1; fi
    trap - INT
  fi
  if [ "$OP_MODE" -eq 1 ]; then
    ok "1Password CLI connected — secrets go to the vault"
  else
    if command -v op >/dev/null; then
      bad "1Password CLI present but not connected/skipped (app → Settings → Developer → Integrate with CLI, then 'op vault list' once)"
    else
      bad "1Password CLI not installed ($OP_HINT)"
    fi
    note "falling back to PLAINTEXT ~/.agent/agent.env (chmod 600). Works, but secrets"
    note "sit on disk — set up 1Password and rerun 'sandbox init' to migrate them off,"
    note "or wire any other secrets manager via AGENT_ENV_COMMAND (see agent.env.example)."
    printf '  continue with plaintext fallback? [y/N]: '
    read -r yn; case "$yn" in y|Y) ;; *) exit 1 ;; esac
  fi

  # Backend: field <name> reads an existing secret (vault, else current env
  # file); store <name> <value> saves one. Plain values held in shell vars and
  # written at the env-file step. Field↔env mapping is fixed.
  var_for() { case "$1" in claude-token) echo CLAUDE_CODE_OAUTH_TOKEN;; github-token) echo GITHUB_TOKEN;; atlassian-token) echo ATLASSIAN_AGENT_TOKEN;; esac; }
  plain_get() { [ -f "$AGENT_ENV" ] && grep "^$(var_for "$1")=" "$AGENT_ENV" | head -1 | cut -d= -f2- | grep -v "^op://" || true; }
  if [ "$OP_MODE" -eq 1 ]; then
    echo "── vault item ──"
    VAULT="${SANDBOX_VAULT:-}"
    if [ -z "$VAULT" ]; then
      printf '  vault to keep agent credentials in [Employee]: '
      read -r VAULT; VAULT="${VAULT:-Employee}"
    fi
    ITEM="${SANDBOX_ITEM:-agent-sandbox}"
    if op item get "$ITEM" --vault "$VAULT" >/dev/null 2>&1; then
      ok "item '$ITEM' exists in vault '$VAULT'"
    else
      op item create --category "API Credential" --vault "$VAULT" --title "$ITEM" >/dev/null \
        && ok "created item '$ITEM' in vault '$VAULT'" \
        || { bad "could not create item (vault name? permissions?)"; exit 1; }
    fi
    ref() { printf 'op://%s/%s/%s' "$VAULT" "$ITEM" "$1"; }
    field() {
      v=$(op read "$(ref "$1")" 2>/dev/null || true)
      if [ -z "$v" ]; then
        # migrate a plaintext value left by a pre-1Password init
        v=$(plain_get "$1")
        [ -n "$v" ] && store "$1" "$v" && note "migrated $1 from plaintext file into the vault"
      fi
      printf '%s' "$v"
    }
    store() { op item edit "$ITEM" --vault "$VAULT" "$1[password]=$2" >/dev/null; }
  else
    ref() { case "$1" in claude-token) printf '%s' "$PLAIN_CT";; github-token) printf '%s' "$PLAIN_GT";; atlassian-token) printf '%s' "$PLAIN_AT";; esac; }
    field() { case "$1" in claude-token) printf '%s' "$PLAIN_CT";; github-token) printf '%s' "$PLAIN_GT";; atlassian-token) printf '%s' "$PLAIN_AT";; esac; }
    store() { case "$1" in claude-token) PLAIN_CT="$2";; github-token) PLAIN_GT="$2";; atlassian-token) PLAIN_AT="$2";; esac; }
    PLAIN_CT=$(plain_get claude-token); PLAIN_GT=$(plain_get github-token); PLAIN_AT=$(plain_get atlassian-token)
  fi

  echo "── claude (setup-token, 1-year) ──"
  v=$(field claude-token)
  case "$v" in
    sk-ant*) ok "claude-token present" ;;
    *) note "browser will open — approve, token is captured directly into the vault"
       # || t="" is load-bearing under set -euo pipefail: a grep miss (no token
       # emitted) would otherwise abort init here, making the paste fallback
       # below unreachable.
       t=$(claude setup-token 2>/dev/null | grep -oE 'sk-ant-[A-Za-z0-9_-]+' | tail -1) || t=""
       case "$t" in
         sk-ant*) store claude-token "$t" && ok "claude-token stored" ;;
         *) bad "could not capture token — run 'claude setup-token', paste result:"
            printf '  token: '; read -rs t; echo
            case "$t" in sk-ant*) store claude-token "$t" && ok "claude-token stored";;
            *) bad "that does not look like a Claude token (sk-ant-…) — skipped"; fail=1;; esac ;;
       esac ;;
  esac

  echo "── github ──"
  v=$(field github-token)
  case "$v" in
    ghp_*|github_pat_*|gho_*) ok "github-token present" ;;
    ATATT*) bad "github-token field holds an ATLASSIAN token — fix the item"; fail=1 ;;
    *) if command -v gh >/dev/null && ! gh auth token >/dev/null 2>&1; then
         printf '  gh CLI found but not logged in — run browser login now? [Y/n]: '
         read -r yn; case "$yn" in n|N) ;; *) gh auth login --web --git-protocol https || true ;; esac
       fi
       if command -v gh >/dev/null && gh auth token >/dev/null 2>&1; then
         note "storing your gh CLI token (broad scope; OAuth works with GitHub Packages — add read:packages via 'gh auth refresh' if private installs fail)"
         store github-token "$(gh auth token)" && ok "github-token stored from gh CLI"
       else
         note "no gh login found. Mint a classic PAT with repo + read:packages (github.com → Settings → Developer settings; GitHub Packages rejects fine-grained PATs)"
         printf '  paste PAT (or Enter to skip): '; read -rs t; echo
         case "$t" in
           ghp_*|github_pat_*) store github-token "$t" && ok "github-token stored" ;;
           "") note "skipped — PR delegation disabled until set" ;;
           ATATT*) bad "that is an Atlassian token, not GitHub — skipped"; fail=1 ;;
           *) bad "unrecognized token format — skipped"; fail=1 ;;
         esac
       fi ;;
  esac

  echo "── atlassian (optional — Enter to skip) ──"
  v=$(field atlassian-token)
  if printf '%s' "$v" | grep -q "^ATATT"; then ok "atlassian-token present"; else
    note "create at: id.atlassian.com → Security → API tokens"
    printf '  paste token (or Enter to skip): '; read -rs t; echo
    case "$t" in
      ATATT*) store atlassian-token "$t" && ok "atlassian-token stored" ;;
      "") note "skipped — Jira/Confluence MCP disabled until set" ;;
      *) bad "Atlassian tokens start with ATATT — skipped"; fail=1 ;;
    esac
  fi
  ATL_URL=""; ATL_EMAIL=""
  if printf '%s' "$(field atlassian-token)" | grep -q "^ATATT"; then
    while :; do
      printf '  Atlassian URL (e.g. https://yourorg.atlassian.net): '; read -r ATL_URL
      case "$ATL_URL" in https://*) break ;; *) bad "full https:// URL, please" ;; esac
    done
    while :; do
      printf '  account email for that token: '; read -r ATL_EMAIL
      case "$ATL_EMAIL" in *@*) break ;; *) bad "no @ in that email — again" ;; esac
    done
  fi

  echo "── writing $AGENT_ENV ──"
  mkdir -p "$(dirname "$AGENT_ENV")"
  [ -f "$AGENT_ENV" ] && { cp "$AGENT_ENV" "$AGENT_ENV.bak"; note "existing file backed up to agent.env.bak"; }
  {
    if [ "$OP_MODE" -eq 1 ]; then
      echo "# generated by 'sandbox init' $(date +%F) — references only, secrets live in 1Password"
    else
      echo "# generated by 'sandbox init' $(date +%F) — PLAINTEXT fallback; set up 1Password and rerun init to migrate"
    fi
    echo "CLAUDE_CODE_OAUTH_TOKEN=$(ref claude-token)"
    echo "GITHUB_TOKEN=$(ref github-token)"
    if [ -n "$ATL_EMAIL" ]; then
      echo "ATLASSIAN_URL=$ATL_URL"
      echo "ATLASSIAN_AGENT_EMAIL=$ATL_EMAIL"
      echo "ATLASSIAN_AGENT_TOKEN=$(ref atlassian-token)"
      echo "# boot check warns on personal Atlassian identities — a scoped svc- account is recommended"
    fi
  } > "$AGENT_ENV"
  chmod 600 "$AGENT_ENV"
  if [ "$OP_MODE" -eq 1 ]; then
    ok "agent.env written (op:// references, zero plaintext)"
  else
    ok "agent.env written (plaintext, chmod 600 — migrate via 1Password + rerun init)"
  fi

  echo "── validation (host-side, live) ──"
  t=$(field claude-token); case "$t" in sk-ant*) ok "claude token: shape valid (sk-ant…, ${#t} chars)";; *) bad "claude token missing/odd"; fail=1;; esac
  t=$(field github-token)
  if [ -n "$t" ]; then
    # || login="" is load-bearing under set -euo pipefail: a rejected token
    # (curl -f exits 22) or a grep miss would otherwise abort init at this
    # assignment, making the "rejected" branch below unreachable.
    login=$(curl -sf --max-time 10 -H "Authorization: Bearer $t" https://api.github.com/user 2>/dev/null | grep -o '"login": *"[^"]*"' | cut -d'"' -f4) || login=""
    if [ -n "$login" ]; then
      ok "github: authenticates as '$login'"
      # Package registries (GitHub Packages maven/npm) take the token as the
      # basic-auth password but many build tools (gradle credentials{}) refuse
      # a null username outright — persist the validated login (not a secret).
      echo "GITHUB_USER=$login" >> "$AGENT_ENV"
      ok "GITHUB_USER=$login written (build tools need a username besides the token)"
      # GitHub Packages readiness — ADVISORY only. A repo with private
      # npm/maven deps needs a packages-capable token, and the failure would
      # otherwise surface four steps later as an E403 mid-`npm ci` phrased as a
      # policy/server problem — so name it here. But a token perfectly fine for
      # git/API (a least-privilege fine-grained PAT with no packages access) is
      # exactly right for a repo with NO private packages: this is a note, never
      # a hard fail, so the generic path makes no private-package assumption.
      # Two shapes to name: fine-grained PATs (github_pat_*) are rejected by
      # GitHub Packages outright — the registry accepts only classic/OAuth
      # tokens (docs: "GitHub Packages only supports authentication using a
      # personal access token (classic)") — and classic/OAuth tokens need the
      # read:packages scope, which they report in the x-oauth-scopes response
      # header. The probe must not take init down with it: this script runs
      # set -euo pipefail, so the curl gets an explicit || fallback and a
      # --max-time so a wedged connection cannot hang the validation step.
      case "$t" in
        github_pat_*)
          note "github: fine-grained PAT — fine for git/API and public registries. If this repo installs PRIVATE GitHub Packages, they will E403 (the registry accepts only classic/OAuth tokens): gh auth refresh -h github.com -s read:packages, or mint a classic PAT with read:packages, then clear the stored github-token and rerun 'sandbox init' (init keeps an existing token; it does not re-capture)" ;;
        *)
          hdrs=$(curl -sfI --max-time 10 -H "Authorization: Bearer $t" https://api.github.com/user 2>/dev/null) || hdrs=""
          if [ -z "$hdrs" ]; then
            note "github: could not read token scopes (transient network?) — if this repo uses private GitHub Packages, ensure the token grants 'read:packages' or those installs E403"
          else
            scopes=$(printf '%s' "$hdrs" | tr -d '\r' | sed -n 's/^[Xx]-[Oo][Aa]uth-[Ss]copes: //p') || scopes=""
            case "$scopes" in
              *read:packages*|*write:packages*) ok "github: read:packages granted (private npm/maven registries resolve)" ;;
              *) note "github: token has no 'read:packages' scope — fine unless this repo installs private GitHub Packages, which would then E403: gh auth refresh -h github.com -s read:packages, then clear the stored github-token and rerun 'sandbox init'" ;;
            esac
          fi ;;
      esac
    else
      bad "github token rejected (401?) or api.github.com unreachable"; fail=1
    fi
  fi
  if [ -n "$ATL_EMAIL" ]; then
    t=$(field atlassian-token)
    # || name="" mirrors the github guard above: a rejected token (curl -f
    # exits 22) or a grep miss must land in the named bad line below, not
    # abort init at this assignment.
    name=$(curl -sf --max-time 10 -u "$ATL_EMAIL:$t" "$ATL_URL/rest/api/2/myself" 2>/dev/null | grep -o '"displayName":"[^"]*"' | cut -d'"' -f4) || name=""
    [ -n "$name" ] && ok "atlassian: authenticates as '$name'" || { bad "atlassian identity check failed (token rejected, wrong email, or URL unreachable)"; fail=1; }
  fi

  echo
  if [ "$fail" -eq 0 ]; then
    echo "done. Next: cd <repo-with-.devcontainer> && sandbox"
  else
    echo "finished with warnings — fix the ✘ lines and rerun: sandbox init"
  fi
  exit "$fail"
fi
# ────────────────────────────── end sandbox init ─────────────────────────────

# ─────────────────────────────── sandbox sync ────────────────────────────────
# Day-2 template maintenance: replace the repo's .devcontainer with the current
# template from its source repo (TEMPLATE_VERSION line 2), then re-apply what is
# the REPO's to keep, not the template's: the variant choice (TEMPLATE_VARIANT
# file, e.g. "java" — written once at setup, survives every sync) and the egress
# allowlist anchor (x-extra-allowed-domains — a repo decision, preserved
# verbatim). Deletions propagate (retired template files go away). Requires:
# gh (authenticated), rsync; git for the review diff.
if [ "${1:-}" = "sync" ]; then
  dir="${2:-.}"
  VFILE="$dir/.devcontainer/TEMPLATE_VERSION"
  [ -f "$VFILE" ] || { echo "sandbox sync: no $VFILE — pre-freshness template; copy .devcontainer from the template repo once by hand" >&2; exit 1; }
  command -v gh >/dev/null || { echo "sandbox sync: gh CLI required" >&2; exit 1; }
  old_ver=$(sed -n 1p "$VFILE")
  chash() { find "$dir/.devcontainer" -type f ! -name '.env' -exec cksum {} \; 2>/dev/null | sort | cksum; }
  pre_hash=$(chash)
  src=$(sed -n 2p "$VFILE"); slug=${src%% *}; tpath=${src#* }; tpath=${tpath%/}; [ "$tpath" = "." ] && tpath=""
  variant=""; [ -f "$dir/.devcontainer/TEMPLATE_VARIANT" ] && variant=$(head -1 "$dir/.devcontainer/TEMPLATE_VARIANT")
  # Repo-owned compose anchors preserved across sync (their values are repo
  # decisions, not the template's): egress allowlist + plugin provisioning.
  anchor_val() { al=$(printf '%s' "$1" | sed 's/^x-//;s/-/_/g'); grep -m1 "^$1:" "$2" 2>/dev/null | sed "s/^$1: *&$al *//"; }
  a_domains=$(anchor_val x-extra-allowed-domains "$dir/.devcontainer/docker-compose.yml")
  a_mkts=$(anchor_val x-plugin-marketplaces "$dir/.devcontainer/docker-compose.yml")
  a_plugins=$(anchor_val x-plugin-baseline "$dir/.devcontainer/docker-compose.yml")

  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  echo "fetching ${slug} (${tpath:-repo root}) ..."
  gh api "repos/${slug}/tarball/HEAD" > "$tmp/t.tgz" || { echo "sandbox sync: fetch failed (gh auth? repo access?)" >&2; exit 1; }
  tar -xzf "$tmp/t.tgz" -C "$tmp" --strip-components=1
  srcdir="$tmp/${tpath:+$tpath/}.devcontainer"
  [ -d "$srcdir" ] || { echo "sandbox sync: $srcdir not found in source repo" >&2; exit 1; }
  # Portable replace-with-deletions (Git Bash ships no rsync): stash the
  # repo-owned files, wipe, copy the template wholesale, restore the stash.
  keep="$tmp/keep"; mkdir "$keep"
  # docker-compose.override.yml is on the keep-list: it is the repo's designated
  # local-patch slot (see the stub's header), so sync must never flatten it back
  # to the template's empty stub.
  for f in .env TEMPLATE_VARIANT docker-compose.override.yml; do
    [ -f "$dir/.devcontainer/$f" ] && cp "$dir/.devcontainer/$f" "$keep/$f"
  done
  rm -rf "$dir/.devcontainer"
  cp -R "$srcdir" "$dir/.devcontainer"
  for f in .env TEMPLATE_VARIANT docker-compose.override.yml; do
    [ -f "$keep/$f" ] && cp "$keep/$f" "$dir/.devcontainer/$f"
  done
  # Activation tripwire: before 2026-08-12a devcontainer.json never loaded the
  # override file, so a repo may carry one that has been DEAD WEIGHT for its
  # whole life — and this sync just wired it into the live compose config. A
  # dormant `networks: [egress]` on the workload would bypass the gateway
  # boundary the moment it loads. Kept-but-differs-from-stub = say so loudly.
  if [ -f "$keep/docker-compose.override.yml" ] \
     && ! cmp -s "$keep/docker-compose.override.yml" "$srcdir/docker-compose.override.yml" 2>/dev/null; then
    echo "  WARN: repo's docker-compose.override.yml was KEPT and is now LOADED into the compose"
    echo "        config (templates before 2026-08-12a ignored this file). Review it before"
    echo "        rebuild: every service/network/mount/env it declares is live in the sandbox."
  fi
  new_ver=$(sed -n 1p "$VFILE")

  if [ -n "$variant" ]; then
    if [ -d "$dir/.devcontainer/variants/$variant" ]; then
      cp "$dir/.devcontainer/variants/$variant/devcontainer.json" "$dir/.devcontainer/devcontainer.json"
      [ -f "$dir/.devcontainer/variants/$variant/docker-compose.yml" ] && \
        cp "$dir/.devcontainer/variants/$variant/docker-compose.yml" "$dir/.devcontainer/docker-compose.yml"
      echo "  variant '$variant' re-applied (from TEMPLATE_VARIANT)"
    else
      echo "  WARN: TEMPLATE_VARIANT names '$variant' but the template has no such variant"
    fi
  fi
  apply_anchor() {
    key=$1; val=$2; f="$dir/.devcontainer/docker-compose.yml"
    [ -n "$val" ] || return 0
    al=$(printf '%s' "$key" | sed 's/^x-//;s/-/_/g')
    grep -q "^$key:" "$f" || return 0
    [ "$(anchor_val "$key" "$f")" = "$val" ] && return 0
    sed -i.bak "s|^$key: &$al .*|$key: \\&$al $val|" "$f" && rm -f "$f.bak"
    echo "  $key preserved: $val"
  }
  apply_anchor x-extra-allowed-domains "$a_domains"
  apply_anchor x-plugin-marketplaces "$a_mkts"
  apply_anchor x-plugin-baseline "$a_plugins"

  echo "template: ${old_ver} → ${new_ver}${variant:+  [$variant]}"
  if git -C "$dir" ls-files --error-unmatch .devcontainer >/dev/null 2>&1; then
    git -C "$dir" --no-pager diff --stat -- .devcontainer | tail -3
    echo "review with: git diff .devcontainer   — then commit"
  else
    echo "note: .devcontainer is not tracked in git here — replaced in place, nothing to diff against"
  fi
  # Files changed ≠ container changed: compose/env edits only land on
  # recreation. Say so — reviewed-then-applied stays two deliberate steps
  # (sync is the reviewable half; rebuild kills a possibly-active session).
  if [ "$pre_hash" != "$(chash)" ]; then
    # Compose lowercases the project name — match it or a MixedCase repo never
    # gets the "container is RUNNING" hint.
    repo_name=$(basename "$(cd "$dir" && pwd)" | tr '[:upper:]' '[:lower:]')
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${repo_name}_devcontainer"; then
      echo "container is RUNNING on the previous template — apply with: sandbox rebuild"
    else
      echo "apply with: sandbox rebuild (next container start picks the changes up)"
    fi
  else
    echo "no content changes — nothing to apply"
  fi
  exit 0
fi
# ───────────────────────────── end sandbox sync ──────────────────────────────

resolved=0
if [ "${1:-}" = "--resolved" ]; then resolved=1; shift; fi

# rebuild (alias: up): recreate the container so .devcontainer changes — new
# compose env, synced template — actually apply. A warm `sandbox` reuses the
# existing container and picks up none of that.
rebuild=""
case "${1:-}" in rebuild|up|--rebuild) rebuild="--remove-existing-container"; shift ;; esac

dir="."
if [ $# -gt 0 ] && [ -d "$1" ]; then dir="$1"; shift; fi

if [ ! -e "$dir/.devcontainer/devcontainer.json" ] && [ ! -e "$dir/.devcontainer.json" ]; then
  echo "sandbox: no .devcontainer in $dir — copy .devcontainer/ from this repo first" >&2
  exit 1
fi

# Resolve credentials into this process env; the container reads them via
# remoteEnv per session. 1Password mode: agent.env holds op:// references only
# (plaintext never touches disk; Touch ID unlocks). Plain mode: values sourced.
if [ -f "$AGENT_ENV" ] && [ "$resolved" -eq 0 ]; then
  if grep -q "op://" "$AGENT_ENV" && ! command -v op >/dev/null; then
    # Fail loudly: sourcing the file would hand sessions the LITERAL op://
    # strings as tokens — auth then fails far downstream with no hint why.
    echo "sandbox: $AGENT_ENV holds op:// references but the 1Password CLI (op) is not installed —" >&2
    echo "  secrets cannot resolve. Install op and integrate it (app → Settings → Developer)," >&2
    echo "  or rerun 'sandbox init' without op to switch to the plaintext fallback." >&2
    exit 1
  fi
  if grep -q "op://" "$AGENT_ENV"; then
    # Re-exec via bash explicitly (not "$0" directly): on native Windows, `op`
    # is a Go binary that launches the target via CreateProcess, which cannot
    # interpret a shebang line — only bash.exe itself is a real executable it
    # can find and run. Harmless no-op on macOS/Linux, where execve("$0",...)
    # would have worked either way.
    exec op run --env-file "$AGENT_ENV" --no-masking -- bash "$0" --resolved ${rebuild:+--rebuild} "$dir" "$@"
  else
    set -a; . "$AGENT_ENV"; set +a
    # Generic secrets-manager hook: if agent.env sets AGENT_ENV_COMMAND, run it
    # and source the KEY=value lines it prints (sops, infisical, bws, pass, …).
    # Secrets then exist only in this process env for this session, same
    # contract as op run. See agent.env.example for per-backend one-liners.
    if [ -n "${AGENT_ENV_COMMAND:-}" ]; then
      set -a; . <(eval "$AGENT_ENV_COMMAND"); set +a
    fi
  fi
fi

# Warm starts run captured-and-quiet (seconds; only WARNINGs surface).
# Slow paths — explicit rebuild, or no container exists yet — stream the
# build live: minutes of silence with activity visible only in the terminal
# title bar reads as a hang.
repo_name=$(basename "$(cd "$dir" && pwd)")
# Compose lowercases the project name, so filter container names through the
# same transform (mount paths keep the original case).
project_name=$(printf '%s' "$repo_name" | tr '[:upper:]' '[:lower:]')
workload_filter=${project_name}_devcontainer-workload
mounts_of() { docker inspect -f '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' "$1" 2>/dev/null; }

# Belt-and-suspenders for the per-repo mount: compose resolves ${SANDBOX_REPO}
# from the process env FIRST, .devcontainer/.env second. The .env file (written
# by initializeCommand) covers VS Code launches; this export covers compose
# versions whose .env discovery misses the project directory (seen in the
# field on Windows: a fresh container came up mounting /workspaces/app).
export SANDBOX_REPO="$repo_name"

# Same belt for ${SANDBOX_VOL_ID} (the per-repo node_modules volume name):
# run the writer now and lift the value out of .env. Parsed, not sourced —
# compose .env is not shell syntax, and a repo name with a space would make
# `.`-sourcing execute the second word as a command.
if [ -f "$dir/.devcontainer/write-env.cjs" ]; then
  (cd "$dir" && node .devcontainer/write-env.cjs) || true
  # || vol_id="" is load-bearing: no node on the host means no .env, and the
  # grep miss would abort here instead of reaching the named tripwires below.
  vol_id=$(grep '^SANDBOX_VOL_ID=' "$dir/.devcontainer/.env" 2>/dev/null | head -1 | cut -d= -f2-) || vol_id=""
  [ -n "$vol_id" ] && export SANDBOX_VOL_ID="$vol_id"
fi

# Self-heal mount drift: `devcontainer up` reuses an existing container
# (--no-recreate), so a workload created by an older template can mount the
# repo at a path the current workspaceFolder no longer points at (e.g. the
# pre-2026-07-29e shared /workspace). Every exec then dies with a cryptic
# "chdir to cwd failed". Detect it and recreate instead of reusing.
if [ -z "$rebuild" ]; then
  cid=$(docker ps -aq -f "name=$workload_filter" 2>/dev/null | head -1)
  if [ -n "$cid" ] && ! mounts_of "$cid" | grep -qx "/workspaces/${repo_name}"; then
    echo "sandbox: existing container mounts the repo at an outdated path — recreating ..."
    rebuild="--remove-existing-container"
  fi
  # Same drift class, newer symptom: a container created before the template
  # grew the node_modules isolation volume still shares the HOST's tree through
  # the bind mount — the synced boot check then runs against the old topology,
  # silently skips the npm credential (its volume gate fails), and a container
  # `npm ci` can wipe the host's install. Compose declaring the volume while
  # the container lacks the mount = recreate, not reuse.
  if [ -n "$cid" ] && grep -q '^  node-modules:' "$dir/.devcontainer/docker-compose.yml" 2>/dev/null \
     && ! mounts_of "$cid" | grep -qx "/workspaces/${repo_name}/node_modules"; then
    echo "sandbox: existing container predates the node_modules isolation volume — recreating ..."
    rebuild="--remove-existing-container"
  fi
  # Same again for the read-only .devcontainer overlay: without it the agent
  # keeps a WRITABLE .devcontainer through the bind mount, and a write there is
  # host code execution at the next up (initializeCommand). Security drift —
  # recreate, not reuse.
  if [ -n "$cid" ] && grep -q '/\.devcontainer:ro' "$dir/.devcontainer/docker-compose.yml" 2>/dev/null \
     && ! mounts_of "$cid" | grep -qx "/workspaces/${repo_name}/.devcontainer"; then
    echo "sandbox: existing container predates the read-only .devcontainer mount — recreating ..."
    rebuild="--remove-existing-container"
  fi
fi
if [ -n "$rebuild" ] || ! docker ps -aq -f "name=${project_name}_devcontainer" 2>/dev/null | grep -q .; then
  [ -n "$rebuild" ] && echo "sandbox: recreating container (rebuild) ..." || echo "sandbox: first build for this repo — streaming ..."
  devcontainer up --workspace-folder "$dir" $rebuild || exit 1
else
  out=$(devcontainer up --workspace-folder "$dir" 2>&1) || { printf '%s\n' "$out" >&2; exit 1; }
  printf '%s\n' "$out" | grep -E 'WARNING' || true
fi

# Named tripwire: if the workload STILL lacks the per-repo mount after up,
# every exec would die with an opaque OCI "chdir to cwd failed". Say what is
# actually wrong instead.
cid=$(docker ps -q -f "name=$workload_filter" 2>/dev/null | head -1)
if [ -n "$cid" ] && ! mounts_of "$cid" | grep -qx "/workspaces/${repo_name}"; then
  echo "sandbox: workload is missing the /workspaces/${repo_name} mount — compose did not" >&2
  echo "  interpolate \${SANDBOX_REPO}. Mounts present:" >&2
  mounts_of "$cid" | sed 's/^/    /' >&2
  echo "  check: cat $dir/.devcontainer/.env  and  docker compose version" >&2
  exit 1
fi

# Boot manifest on EVERY launch (a warm container skips postStart): run the
# check with this session's resolved credentials; refuse to open on failure.
if ! devcontainer exec --workspace-folder "$dir" bash .devcontainer/check-agent-env.sh; then
  echo "sandbox: boot check refused this session (see above)" >&2
  exit 1
fi

exec devcontainer exec --workspace-folder "$dir" claude "$@"
