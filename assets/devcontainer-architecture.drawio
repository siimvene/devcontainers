<mxfile host="Electron" agent="handcrafted">
  <diagram id="devcontainer-arch" name="Agent Sandbox Architecture">
    <mxGraphModel dx="1358" dy="1018" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="host" parent="1" style="rounded=1;dashed=1;dashPattern=8 4;strokeColor=#666666;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;align=left;spacingLeft=10;spacingTop=6;" value="Developer machine (macOS / Linux / WSL2)" vertex="1">
          <mxGeometry height="660" width="310" x="30" y="40" as="geometry" />
        </mxCell>
        <mxCell id="sandboxcli" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" value="sandbox CLI&#xa;init: guided onboarding (~5 min)&#xa;launch: resolve creds → up → boot manifest → claude&#xa;(refuses to open on failed check)" vertex="1">
          <mxGeometry height="96" width="260" x="55" y="80" as="geometry" />
        </mxCell>
        <mxCell id="agentenv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" value="~/.agent/agent.env&#xa;references only on disk — zero plaintext" vertex="1">
          <mxGeometry height="52" width="260" x="55" y="196" as="geometry" />
        </mxCell>
        <mxCell id="onepw" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" value="secrets manager (1Password, sops, &#8230;)&#xa;github-token · atlassian-token · claude-setup-token" vertex="1">
          <mxGeometry height="72" width="260" x="55" y="268" as="geometry" />
        </mxCell>
        <mxCell id="managed" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" value="managed-settings.json (MDM)&#xa;bypass / auto mode DISABLED on host —&#xa;autonomy only exists inside the container" vertex="1">
          <mxGeometry height="80" width="260" x="55" y="360" as="geometry" />
        </mxCell>
        <mxCell id="volumes" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" value="Named volumes — machine-scoped&#xa;agent-claude-config · agent-codex-config ·&#xa;agent-bash-history · agent-gradle-cache&#xa;(one login per vendor per machine;&#xa;auth + plugins survive rebuilds)" vertex="1">
          <mxGeometry height="104" width="260" x="55" y="460" as="geometry" />
        </mxCell>
        <mxCell id="browser" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" value="browser → 127.0.0.1:3000&#xa;dev-server ingress, published on gateway" vertex="1">
          <mxGeometry height="52" width="260" x="55" y="584" as="geometry" />
        </mxCell>
        <mxCell id="sessionnote" parent="1" style="text;html=1;align=left;fontSize=10;fontStyle=2;" value="Credentials are SESSION-scoped (remoteEnv): a bare exec gets the base profile, no secrets." vertex="1">
          <mxGeometry height="40" width="260" x="55" y="644" as="geometry" />
        </mxCell>
        <mxCell id="boundary" parent="1" style="rounded=1;dashed=1;dashPattern=8 4;strokeColor=#2e9a4e;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;align=left;spacingLeft=10;spacingTop=6;" value="docker — HOST-ENFORCED boundary (per repo, committed .devcontainer/)" vertex="1">
          <mxGeometry height="660" width="620" x="400" y="40" as="geometry" />
        </mxCell>
        <mxCell id="workload" parent="1" style="rounded=0;strokeColor=#666666;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;spacingTop=4;" value="WORKLOAD — the agent runs here" vertex="1">
          <mxGeometry height="380" width="340" x="420" y="80" as="geometry" />
        </mxCell>
        <mxCell id="bootcheck" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" value="check-agent-env.sh — boot manifest&#xa;egress containment self-test · auth preflight&#xa;(claude / codex / github / jira) · refuses personal&#xa;data-plane tokens · AGENT_REQUIRE_AUTH=1&#xa;hard-fails unattended runs" vertex="1">
          <mxGeometry height="88" width="310" x="435" y="112" as="geometry" />
        </mxCell>
        <mxCell id="claude" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Claude Code&#xa;auto mode default&#xa;(classifier-supervised)" vertex="1">
          <mxGeometry height="64" width="145" x="435" y="216" as="geometry" />
        </mxCell>
        <mxCell id="codexgh" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Codex CLI · gh CLI&#xa;cross-vendor opt-in;&#xa;PRs as bot identity" vertex="1">
          <mxGeometry height="64" width="147" x="598" y="216" as="geometry" />
        </mxCell>
        <mxCell id="workspace" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" value="Workspace — bind mount, the repo ONLY&#xa;(no home dir, no ~/.ssh, no host secrets)" vertex="1">
          <mxGeometry height="52" width="310" x="435" y="296" as="geometry" />
        </mxCell>
        <mxCell id="netstance" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" value="Network stance: contained by topology&#xa;internal-only net · NO route to internet ·&#xa;NO external DNS · NO NET_ADMIN&#xa;(root + sudo allowed — harmless for egress)" vertex="1">
          <mxGeometry height="80" width="310" x="435" y="364" as="geometry" />
        </mxCell>
        <mxCell id="gateway" parent="1" style="rounded=0;strokeColor=#666666;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;spacingTop=4;" value="GATEWAY — agent has NO root" vertex="1">
          <mxGeometry height="380" width="210" x="790" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tinyproxy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" value="tinyproxy&#xa;egress allowlist by HOSTNAME&#xa;(CONNECT), default-DENY&#xa;rendered from base set +&#xa;EXTRA_ALLOWED_DOMAINS" vertex="1">
          <mxGeometry height="120" width="180" x="805" y="112" as="geometry" />
        </mxCell>
        <mxCell id="socat" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" value="socat :3000&#xa;dev-port forward to the&#xa;workload (opt-in ingress)" vertex="1">
          <mxGeometry height="64" width="180" x="805" y="248" as="geometry" />
        </mxCell>
        <mxCell id="gwnote" parent="1" style="text;html=1;align=left;fontSize=10;fontStyle=2;whiteSpace=wrap;" value="on BOTH networks: internal (to workload) + egress bridge (to internet).&#xa;&#xa;Boundary = docker topology, not rules the agent can reach (survives sudo iptables -F)." vertex="1">
          <mxGeometry height="120" width="180" x="805" y="324" as="geometry" />
        </mxCell>
        <mxCell id="sidecars" parent="1" style="rounded=0;dashed=1;dashPattern=6 3;strokeColor=#9673a6;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=11;align=left;spacingLeft=10;spacingTop=4;" value="Sidecars — internal net only, NO egress (declared in repo compose = reviewable)" vertex="1">
          <mxGeometry height="90" width="580" x="420" y="490" as="geometry" />
        </mxCell>
        <mxCell id="postgres" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="postgres:16 — db:5432&#xa;(no host port published)" vertex="1">
          <mxGeometry height="46" width="180" x="435" y="522" as="geometry" />
        </mxCell>
        <mxCell id="moresidecars" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="kafka / redis / … per repo&#xa;(testcontainers replacement, no DinD)" vertex="1">
          <mxGeometry height="46" width="220" x="640" y="522" as="geometry" />
        </mxCell>
        <mxCell id="javavariant" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;" value="Java variant: JDK 21 feature · gradle cache volume · JVM proxy wiring · build registries (Maven Central, Gradle portals, Spring, …) added to the gateway allowlist" vertex="1">
          <mxGeometry height="80" width="580" x="420" y="600" as="geometry" />
        </mxCell>
        <mxCell id="egress" parent="1" style="rounded=1;dashed=1;dashPattern=8 4;strokeColor=#b85450;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;align=left;spacingLeft=10;spacingTop=6;" value="Internet — via gateway only" vertex="1">
          <mxGeometry height="500" width="310" x="1060" y="40" as="geometry" />
        </mxCell>
        <mxCell id="anthropic" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" value="api.anthropic.com · claude.ai&#xa;model requests — subscription token, org key or gateway, via env precedence&#xa;(same image serves laptop and fleet)" vertex="1">
          <mxGeometry height="76" width="260" x="1085" y="80" as="geometry" />
        </mxCell>
        <mxCell id="github" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" value="github.com · api.github.com&#xa;git push + gh pr create&#xa;as scoped bot / dev identity" vertex="1">
          <mxGeometry height="62" width="260" x="1085" y="176" as="geometry" />
        </mxCell>
        <mxCell id="npm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" value="registry.npmjs.org&#xa;+ build registries (java variant)" vertex="1">
          <mxGeometry height="48" width="260" x="1085" y="258" as="geometry" />
        </mxCell>
        <mxCell id="extra" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" value="EXTRA_ALLOWED_DOMAINS&#xa;yourorg.atlassian.net — Jira MCP, svc account · api.openai.com — codex&#xa;(widening egress = a reviewed diff line)" vertex="1">
          <mxGeometry height="76" width="260" x="1085" y="326" as="geometry" />
        </mxCell>
        <mxCell id="blocked" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;fontStyle=1;" value="EVERYTHING ELSE — DENIED&#xa;hostname allowlist: shared-CDN IPs can&#39;t reach unlisted hosts; no external DNS = no DNS tunnel&#xa;(verified: root, proxy env stripped — still no socket)" vertex="1">
          <mxGeometry height="90" width="260" x="1085" y="422" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" value="Legend&#xa;green — tooling / allowed path&#xa;yellow — credential material&#xa;orange — gates &amp;amp; per-repo decisions&#xa;red — enforcement / deny&#xa;blue — data &amp;amp; storage&#xa;purple — stack variant" vertex="1">
          <mxGeometry height="130" width="310" x="1060" y="580" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="agentenv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="onepw" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="sandboxcli" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="bootcheck" value="session-scoped env (remoteEnv)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="codexgh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="tinyproxy" value="HTTPS_PROXY :8888">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="tinyproxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="anthropic" value="allowed CONNECT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="netstance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="sidecars" value="internal net">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="browser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;exitX=1;exitY=0.25;entryX=1;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="socat" value="ingress: published port → socat → workload">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="315" y="590" />
              <mxPoint x="1010" y="590" />
              <mxPoint x="1010" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="volumes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="workload" value="auth persists">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
