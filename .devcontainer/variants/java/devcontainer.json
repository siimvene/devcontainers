{
  "name": "agent-sandbox-java",
  // Compose-based: the workload, its egress gateway, and the declared sidecars
  // (DB etc.) start together. Copy the base .devcontainer/ wholesale first, then
  // copy BOTH files from variants/java/ into .devcontainer/, OVERWRITING the base
  // devcontainer.json AND the base docker-compose.yml — this file with the base
  // compose fails at postCreate (no gradle volume, no JVM proxy wiring, empty
  // build allowlist). The gateway/ dir must be present alongside.
  // Override file = the repo's local-patch slot, preserved by `sandbox sync`
  // (same contract as the base template; the stub ships alongside).
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.override.yml"],
  "service": "workload",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // Per-repo mount path: folder trust, project settings, and history key on the
  // workspace path — a shared /workspace would make one trust decision cover
  // every sandboxed repo on the machine. Compose can't substitute devcontainer
  // variables, so initializeCommand (host-side, cwd = the workspace folder)
  // writes .devcontainer/.env for compose interpolation of ${SANDBOX_REPO}.
  // Gitignored; rewritten every up. Array form is load-bearing: it spawns the
  // process directly, with no host shell in the middle. A string command goes
  // through `cmd.exe /c` (without /s) on Windows, whose first/last quote
  // stripping mangles a quoted script and leaves .env unwritten — compose then
  // defaults the mount path and every exec dies with "chdir to cwd failed".
  // Consequence: node on the host PATH is a hard requirement (already a
  // documented Windows prerequisite per WINDOWS.md); a missing node now fails
  // loudly here instead of silently mounting the repo at the wrong path.
  // .cjs so a `"type": "module"` consuming repo can't turn it into ESM and break
  // its `require` — see the header comment in the script.
  // Keep in lockstep with the base devcontainer.json: `sandbox sync` copies this
  // file OVER the base one whenever TEMPLATE_VARIANT names this variant, so a
  // fix that lands only in the base never reaches a java repo.
  "initializeCommand": ["node", ".devcontainer/write-env.cjs"],

  // Credentials arrive per-session via remoteEnv (injected at exec time, never
  // stored in the container config — nothing in `docker inspect`).
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "ANTHROPIC_AUTH_TOKEN": "${localEnv:ANTHROPIC_AUTH_TOKEN}",
    "ANTHROPIC_BASE_URL": "${localEnv:ANTHROPIC_BASE_URL}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GITHUB_USER": "${localEnv:GITHUB_USER}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "ATLASSIAN_URL": "${localEnv:ATLASSIAN_URL}",
    "ATLASSIAN_AGENT_EMAIL": "${localEnv:ATLASSIAN_AGENT_EMAIL}",
    "ATLASSIAN_AGENT_TOKEN": "${localEnv:ATLASSIAN_AGENT_TOKEN}",
    "AGENT_IDENTITY_PATTERN": "${localEnv:AGENT_IDENTITY_PATTERN}",
    "AGENT_REQUIRE_AUTH": "${localEnv:AGENT_REQUIRE_AUTH}"
  },

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Node stays the base image (claude-code needs it); Java rides on top.
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      // The reference monorepo's build.gradle sets JavaLanguageVersion.of(25)
      // as its compile toolchain — newer than this feature's primary
      // "version" (21, which stays the JVM that runs Gradle itself). Rather
      // than rely on Gradle's foojay-resolver auto-download at runtime (that
      // goes through the gateway allowlist — api.foojay.io plus wherever it
      // redirects to fetch the actual JDK — one more domain to punch through
      // per JDK release), install it at build time instead (unrestricted
      // network); Gradle auto-detects it via SDKMAN's candidates dir, wired
      // up by configure-gradle-toolchains.sh below. Comma-separated if a repo
      // needs more than one extra version; drop to "" if the repo's
      // toolchain matches "version" and no extra JDK is needed.
      "additionalVersions": "25",
      "installGradle": false
    }
  },

  "remoteUser": "node",

  // Same contract as the base template, plus the gradle cache volume chown.
  // No init-firewall: egress is enforced by the gateway, not in-container.
  // safe.directory: on Windows hosts the bind-mounted workspace arrives owned
  // 0:0 while we run as node (uid 1000), so every git command aborts on
  // "dubious ownership". "$PWD" rather than a substituted
  // ${containerWorkspaceFolder}, which the shell would re-parse: a directory
  // named `repo$(...)` or holding a space would command-substitute or split and
  // break the && chain. Lifecycle commands already run from the workspace folder.
  "postCreateCommand": "mountpoint -q /home/node/.gradle || { echo 'ERROR: gradle-cache volume not mounted — you are running the java variant devcontainer.json against the BASE docker-compose.yml. Copy variants/java/docker-compose.yml over .devcontainer/docker-compose.yml and rebuild.'; exit 1; }; sudo chown node:node /home/node/.claude /home/node/.codex /home/node/.gradle /home/node/.npm-config /commandhistory \"$PWD/node_modules\" && git config --global --add safe.directory \"$PWD\" && bash .devcontainer/setup-cross-vendor.sh && bash .devcontainer/setup-memspec.sh && bash .devcontainer/variants/java/configure-gradle-toolchains.sh",
  "postStartCommand": "bash .devcontainer/check-agent-env.sh",

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  }
}
